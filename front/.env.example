# Medusa backend (required)
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Stripe (optional — required for live card payments)
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_key

# Sanity CMS (required for Origins / Brewing Guides)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_READ_TOKEN=your_read_token
SANITY_STUDIO_URL=https://your-project.sanity.studio

# ISR / preview
REVALIDATE_SECRET=your_revalidate_secret
PREVIEW_TOKEN=your_preview_token
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Sitemap (optional)
NEXT_PUBLIC_VERCEL_URL=http://localhost:8000

# Playwright E2E (optional — defaults to unique register per run)
E2E_COUNTRY_CODE=us
# E2E_CUSTOMER_EMAIL=e2e@zentee.test
# E2E_CUSTOMER_PASSWORD=E2eTestPass123!
